trap 'rm -rf "$temp_dir"' EXIT
zed_dir="${temp_dir}/zed$suffix.app"

# Cargo may reuse its outputs on the next invocation. Strip packaging copies
# so reruns still upload full ELFs and extract complete debug companions.
mkdir -p "${zed_dir}/bin" "${zed_dir}/libexec"
llvm-objcopy --strip-unneeded "${target_dir}/${target_triple}/release/zed" "${zed_dir}/libexec/zed-editor"
llvm-objcopy --strip-debug --discard-all "${target_dir}/${target_triple}/release/cli" "${zed_dir}/bin/zed"
llvm-objcopy --strip-debug --discard-all "${target_dir}/${remote_server_triple}/release/remote_server" "${temp_dir}/remote_server"
>>>>>>> c836b6c0a5d23ac217d36f8897dc78c4325ba5f4

# Libs
# Bundle libstdc++ so older supported systems can run binaries built with our
# toolchain even when their system libstdc++.so.6 lacks required GLIBCXX symbols.
#
# Never bundle the GLib family or its private dependencies: host libraries that
# get dlopen'd are built against the system GLib, and resolving them against an
# older bundled copy fails with missing symbols.
find_libs() {
    ldd ${target_dir}/${target_triple}/release/wu |\
        cut -d' ' -f3 |\
        grep -v '\<\(libc.so\|libgcc_s.so\|libm.so\|libpthread.so\|libdl.so\|libasound.so\)' |\
        grep -v '\<\(libglib-2.0.so\|libgobject-2.0.so\|libgio-2.0.so\|libgmodule-2.0.so\|libpcre.so\|libpcre2-8.so\|libmount.so\|libblkid.so\|libselinux.so\|libffi.so\|libresolv.so\|libz.so\)'
}

mkdir -p "${wu_dir}/lib"
rm -rf "${wu_dir}/lib/*"
cp $(find_libs) "${wu_dir}/lib"

# Icons
mkdir -p "${wu_dir}/share/icons/hicolor/512x512/apps"
cp "crates/wu/resources/app-icon$suffix.png" "${wu_dir}/share/icons/hicolor/512x512/apps/wu.png"
mkdir -p "${wu_dir}/share/icons/hicolor/1024x1024/apps"
cp "crates/wu/resources/app-icon$suffix@2x.png" "${wu_dir}/share/icons/hicolor/1024x1024/apps/wu.png"

# .desktop
export DO_STARTUP_NOTIFY="true"
export APP_CLI="wu"
export APP_ICON="wu"
export APP_ARGS="%U"
if [[ "$channel" == "dev" ]]; then
  export APP_NAME="Wu Dev"
  APP_ID="me.farshed.Wu-Dev"
else
  export APP_NAME="Wu"
  APP_ID="me.farshed.Wu"
fi

mkdir -p "${wu_dir}/share/applications"
envsubst < "crates/wu/resources/zed.desktop.in" > "${wu_dir}/share/applications/$APP_ID.desktop"
chmod +x "${wu_dir}/share/applications/$APP_ID.desktop"

# Copy generated licenses so they'll end up in archive too
cp "assets/licenses.md" "${wu_dir}/licenses.md"

# Create archive out of everything that's in the temp directory
arch=$(uname -m)
archive="wu-linux-${arch}.tar.gz"

rm -rf "${archive}"
remove_match="wu(-[a-zA-Z0-9]+)?-linux-$(uname -m)\.tar\.gz"
ls "${target_dir}/release" | grep -E ${remove_match} | xargs -d "\n" -I {} rm -f "${target_dir}/release/{}" || true
tar -czvf "${target_dir}/release/$archive" -C ${temp_dir} "wu$suffix.app"

